[
  {
    "context": "Editor && VimControl",
    "bindings": {
      "ctrl-h": "editor::Hover",
      "ctrl-v": "editor::Paste",
      "ctrl-b": "workspace::ToggleLeftDock"
    }
  },
  {
    "context": "vim_mode == insert",
    "bindings": {
      "ctrl-v": "editor::Paste"
    }
  },
  {
    "context": "vim_mode != insert",
    "bindings": {
      "ctrl-b": "workspace::ToggleLeftDock",
      "ctrl-alt-b": "workspace::ToggleRightDock",
      "ctrl-j": "terminal_panel::Toggle",
    }
  },
  {
    "bindings": {
      "ctrl-shift-w": "pane::CloseActiveItem",
    }
  }
]
